#!/bin/bash

# --- Resource Requests ---
# Evaluation is usually quick, 20 mins should be plenty.

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4         # Request 4 CPUs (for 4 data loader workers in eval_test.py)
#SBATCH --gres=gpu:a100           # Request one A100 GPU
#SBATCH --time=00:20:00           # 20-minute time limit
#SBATCH --job-name=adni_evaluate  # Job name for evaluation
#SBATCH -o adni_evaluate_%j.out   # Standard output log
#SBATCH -e adni_evaluate_%j.err   # Standard error log

# --- Your Commands ---
echo "Starting ADNI Evaluation job $SLURM_JOB_ID on $(hostname)"
echo "Loading Conda environment..."

# Activate the conda environment
source ~/miniconda3/bin/activate torch

echo "Conda environment activated. Running Python evaluation script..."

# Run your evaluation script
python eval_test.py

echo "Evaluation job finished"
