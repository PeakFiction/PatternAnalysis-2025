#!/bin/bash

# --- Resource Requests ---
# We keep cpus-per-task=4 to match NUM_WORKERS=4 in your train.py

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4         # Request 4 CPUs (for 4 data loader workers)
#SBATCH --gres=gpu:a100           # Request one A100 GPU (from the guide's example)
#SBATCH --job-name=oasis_unet     # A name for your job
#SBATCH -o oasis_unet_%j.out      # Saves all print output
#SBATCH -e oasis_unet_%j.err      # Saves all errors

# --- Your Commands ---
echo "Starting job $SLURM_JOB_ID on $(hostname)"
echo "Loading Conda environment..."

# Activate the conda environment
source ~/miniconda3/bin/activate torch

echo "Conda environment activated. Running Python script..."

# Run your main training script
# This will train the model, validate it, and save the best checkpoint
python train.py

echo "Job finished"
