#!/bin/bash

# --- Resource Requests ---
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4         # Request 4 CPUs for data loading
#SBATCH --gres=gpu:a100           # Request an A100 GPU (might be overkill for eval, but ensures CUDA)
#SBATCH --time=00:20:00           # Request 20 minutes (HH:MM:SS)
#SBATCH --job-name=oasis_eval     # A name for the evaluation job
#SBATCH -o oasis_eval_%j.out      # Saves all print output to a file
#SBATCH -e oasis_eval_%j.err      # Saves all errors to a file

# --- Your Commands ---
echo "Starting evaluation job $SLURM_JOB_ID on $(hostname)"

echo "Loading Conda environment..."
# Activate the conda environment (make sure 'torch' is the correct name)
source ~/miniconda3/bin/activate torch
echo "Conda environment activated. Running evaluation script..."

# Run the evaluation script
python evaluate_test.py

echo "Evaluation job finished"
